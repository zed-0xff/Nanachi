{
  "docker": {
    "mounts": [
      {
        "type": "bind",
        "source": "${HOME}/projects/Nanachi",
        "target": "/workspace/Nanachi",
        "read_only": false
      },
      {
        "type": "bind",
        "source": "${HOME}/projects/TFTTool",
        "target": "/workspace/TFTTool",
        "read_only": true
      },
      {
        "type": "bind",
        "source": "/${HOME}/projects/.opencode",
        "target": "/workspace/.local/share/opencode",
        "read_only": false
      }
    ]
  }
}
